{
  "cli": {
    "version": ">= 22.4.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "PNPM_CONFIG_ONLY_BUILT_DEPENDENCIES": "unrs-resolver"
      }
    },
    "preview": {
      "distribution": "internal",
      "android": { "buildType": "apk" },
      "ios": {
        "simulator": true
      },
      "env": {
        "PNPM_CONFIG_ONLY_BUILT_DEPENDENCIES": "unrs-resolver",
        "EXPO_PUBLIC_STRAVA_CLIENT_ID": "",
        "EXPO_PUBLIC_STRAVA_CLIENT_SECRET": ""
      }
    },
    "production": {
      "autoIncrement": true
    }
  },
  "submit": {
    "production": {}
  }
}
